# Ollama upstream used by the Vite dev proxy and the production server.
OLLAMA_HOST=http://127.0.0.1:11434

# Production server bind settings (npm start).
PORT=3000
HOST=127.0.0.1

# Optional shared secret for /ollama/* and /api/import.
# Leave empty for the default localhost-only setup. If you bind to a LAN
# address, set PROXY_TOKEN here and the same value as VITE_PROXY_TOKEN before
# building, otherwise the proxy is unauthenticated.
# PROXY_TOKEN=change-me
# VITE_PROXY_TOKEN=change-me

# Optional: only set when the browser can reach Ollama directly.
# Leave unset to use the same-origin /ollama proxy.
# VITE_OLLAMA_BASE_URL=http://127.0.0.1:11434
