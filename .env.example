# Ollama upstream used by the Vite dev proxy and the production server.
OLLAMA_HOST=http://127.0.0.1:11434

# Production server bind settings (npm start).
PORT=3000
HOST=127.0.0.1

# Optional shared secret for /ollama/* and the local management APIs
# (/api/import, /api/modelscope, /api/downloads, /api/cache, /api/export,
# /api/metrics, /api/daemon).
# Leave empty for the default localhost-only setup. If you bind to a LAN
# address, set PROXY_TOKEN here and the same value as VITE_PROXY_TOKEN before
# building, otherwise the proxy is unauthenticated.
# PROXY_TOKEN=change-me
# VITE_PROXY_TOKEN=change-me

# Optional: override the model directory scanned by /api/cache and /api/export.
# This does not change the Ollama daemon's own OLLAMA_MODELS setting.
# OLLAMA_MODELS=/path/to/models

# Optional: allow the telemetry page to execute restart/stop commands.
# Disabled by default. Only loopback requests are accepted; copying the
# detected command works without this flag.
# ALLOW_DAEMON_CONTROL=1

# Optional: only set when the browser can reach Ollama directly.
# Leave unset to use the same-origin /ollama proxy.
# VITE_OLLAMA_BASE_URL=http://127.0.0.1:11434
