# Ollama upstream used by the Vite dev proxy and the production server.
OLLAMA_HOST=http://127.0.0.1:11434

# Production server bind settings (npm start).
PORT=39471
HOST=127.0.0.1

# Optional access token. When set, /ollama/* and /api/* require a session.
# The browser exchanges the token for an HttpOnly SameSite=Strict cookie at
# /login; the token is never embedded in the frontend bundle. Scripts may use
# `Authorization: Bearer <token>` or `X-Proxy-Token: <token>`.
# Generate with: openssl rand -hex 32
# PROXY_TOKEN=

# Additional hostnames accepted in the Host header (comma-separated).
# IP literals, localhost, *.localhost and the machine hostname are always
# allowed. Add LAN DNS names here; never add public wildcard domains.
# ALLOWED_HOSTS=studio.lan

# Mark the session cookie Secure when the app is served over HTTPS
# (for example behind a TLS reverse proxy).
# COOKIE_SECURE=1

# Refuse to start when HOST is non-loopback and PROXY_TOKEN is unset.
# Set to 1 only for a trusted network; this is not authentication.
# ALLOW_INSECURE_BIND=1

# Optional: override the model directory scanned by /api/cache and /api/export.
# This does not change the Ollama daemon's own OLLAMA_MODELS setting.
# OLLAMA_MODELS=/path/to/models

# Optional: allow the telemetry page to execute restart/stop commands.
# Disabled by default. Only loopback requests are accepted; copying the
# detected command works without this flag.
# ALLOW_DAEMON_CONTROL=1

# Optional: only set when the browser can reach Ollama directly.
# Leave unset to use the same-origin /ollama proxy.
# VITE_OLLAMA_BASE_URL=http://127.0.0.1:11434
